# Copy to .env.local (git-ignored) and adjust. These are all NEXT_PUBLIC_ vars,
# inlined into the client bundle at `next build` - set them wherever the site
# is built for production, not just locally.

# Base URL of the SendEmail Worker. The contact form POSTs to `${this}/send`.
# For local dev against `wrangler dev`, use http://localhost:8787
NEXT_PUBLIC_API_BASE_URL=https://sendemail-api.tiny-pond-6922.workers.dev

# This site's delivery config, sent in the request body (the Worker only
# checks the Origin). fromEmail must be on a domain verified in Resend.
NEXT_PUBLIC_CONTACT_TO_EMAIL=info@skookuminfotech.com
NEXT_PUBLIC_CONTACT_FROM_EMAIL=noreply@skookuminfotech.com
NEXT_PUBLIC_CONTACT_FROM_NAME=Venmertech
