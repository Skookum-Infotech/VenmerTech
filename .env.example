# Base URL of the transactional-email API (Cloudflare Worker).
# The contact form POSTs to `${NEXT_PUBLIC_API_BASE_URL}/send`.
#
# Required. This site is a static export, so Next.js inlines NEXT_PUBLIC_* values
# at build time — set this wherever `next build` runs (locally in .env.local, and
# in your hosting provider's environment variables for deploys). There is no
# hardcoded fallback in the code.
#
# Copy this file to `.env.local` to get started.
NEXT_PUBLIC_API_BASE_URL=sendmail worker url here
